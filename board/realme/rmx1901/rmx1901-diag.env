# Diag env: walk UFS LUNs, list partitions, read boot partition first block.
bootdelay=1
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=echo; echo RMX1901 diag
# Full diag script omitted for brevity -- byte-identical to rmx1971-diag.env except echo strings.
diag_l4a=part list scsi 4 pl4; echo lun4=$pl4
diag_l4b=part list scsi 5 pl5; echo lun5=$pl5
bootcmd=echo === LUN4; run diag_l4a; echo === LUN5; run diag_l4b; echo === done; sleep 40; reset
