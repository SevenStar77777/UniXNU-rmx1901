bootdelay=5
bootcmd=echo ===UFS-HC===; md.l 0x1d84000 0x10; echo ===PHY-1d87000===; md.l 0x1d87000 0x4; echo ===PHY-1d80000===; md.l 0x1d80000 0x4; echo ===APPS-SMMU===; md.l 0x15000000 0x10; echo ===GCC===; md.l 0x100000 0x4; echo ===DONE===; fastboot usb 0
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole