# Probe env: no storage scan, no video dep.
# If U-Boot runs at all it boots, waits 15s, resets -> ~17s auto reboot.
bootdelay=2
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
preboot=echo probe: rmx1901 preboot reached
bootcmd=echo probe: rmx1901 u-boot is running, resetting in 15s; sleep 15; reset
