# Realme X (RMX1901) deltas on top of qcom_defconfig + qcom-phone.config.
# Verbatim copy of rmx1971.config (both are SDM710 Kryo 360 Realmes),
# only the ENV_DEFAULT_ENV_TEXT_FILE path is swapped + MMC/SDHCI disabled.

CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/realme/rmx1901/rmx1901-probe.env"
CONFIG_CMD_SYSBOOT=y
CONFIG_CMD_BCB=y
CONFIG_SYS_CBSIZE=1024

CONFIG_EFI_LOADER=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BINARY=y
CONFIG_CMD_BOOTEFI_BOOTMGR=y

CONFIG_VIDEO_SIMPLE=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y

# Storage: UFS only, no eMMC/SD. Explicitly disable SDHCI/MMC to avoid
# undefined reference to 'mmc_send_tuning' when qcom_defconfig pulls in
# MMC SDHC I as an indirect dependency on newer U-Boot (sirius/v2.0).
CONFIG_UFS=y
CONFIG_UFS_QCOM=y
CONFIG_SCSI=y
CONFIG_MMC=n
CONFIG_MMC_SDHCI=n
CONFIG_MMC_SDHCI_QCOM=n
CONFIG_MMC_SDHCI_MSM=n

CONFIG_EFI_PARTITION=y
CONFIG_CMD_PART=y

CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y

CONFIG_FASTBOOT_FLASH_BLOCK=y
CONFIG_FASTBOOT_FLASH_BLOCK_INTERFACE_NAME="scsi"
CONFIG_FASTBOOT_FLASH_BLOCK_DEVICE_ID=0
