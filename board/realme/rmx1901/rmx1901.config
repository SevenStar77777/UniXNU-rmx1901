# Realme X (RMX1901) deltas on top of qcom_defconfig + qcom-phone.config.
# Applied as kconfig fragments: make qcom_defconfig qcom-phone.config rmx1901.config
# Byte-identical to rmx1971.config except ENV_DEFAULT_ENV_TEXT_FILE path.

CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/realme/rmx1901/rmx1901-probe.env"
CONFIG_CMD_SYSBOOT=y
CONFIG_CMD_BCB=y
CONFIG_SYS_CBSIZE=1024

# UEFI: what UniXNU actually needs.
CONFIG_EFI_LOADER=y
CONFIG_CMD_BOOTEFI=y
CONFIG_CMD_BOOTEFI_BINARY=y
CONFIG_CMD_BOOTEFI_BOOTMGR=y

# Console: ABL splash at 0x9c000000, no UART on retail.
CONFIG_VIDEO_SIMPLE=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y

# Storage: UFS, not eMMC.
CONFIG_UFS=y
CONFIG_UFS_QCOM=y
CONFIG_SCSI=y

# Partition tables (GPT on 4 KiB logical blocks).
CONFIG_EFI_PARTITION=y
CONFIG_PARTITION_TABLE_EFI=y
CONFIG_PARTITION_TABLE_PARTS=y
CONFIG_PARTITION_CMD=y
CONFIG_CMD_PART=y
CONFIG_CMD_PART_ENV=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_EXT4=y
CONFIG_FS_EXT4=y

# Fastboot over USB gadget.
CONFIG_CMD_FASTBOOT=y
CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_BLOCK=y
CONFIG_FASTBOOT_FLASH_BLOCK_INTERFACE_NAME="scsi"
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_GADGET=y
CONFIG_USB_GADGET_MANUFACTURER="realme"
CONFIG_USB_GADGET_VENDOR_NUM=0x2a96
CONFIG_USB_GADGET_PRODUCT_NUM=0x9008
CONFIG_FASTBOOT_OEM_RUN=y
CONFIG_FASTBOOT_OEM_CONSOLE=y
CONFIG_CMD_CONSOLE=y
CONFIG_CONSOLE_RECORD=y

# Network (optional, for future UniXNU bring-up).
CONFIG_CMD_NET=y
CONFIG_NET=y
CONFIG_CMD_PING=y
CONFIG_CMD_DHCP=y

# Allow loading PE32+ (EFI payload UniXNU.efi).
CONFIG_CMD_EFI_PAYLOAD=y
