bootdelay=1
bootretry=-1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole
kernel_addr_r=0x80080000
fdt_addr_r=0x82a00000
scriptaddr=0x82800000
# UFS shows up as a SCSI device; without a scan there are no partitions at all.
preboot=echo; echo RMX1901 U-Boot
# Three ways in, tried in order.
#
# 1. The EFI boot manager. It walks the block devices, finds a FAT partition and
#    runs \EFI\BOOT\BOOTAA64.EFI, with the payload volume on vm-system
#    (128 MiB, LUN0 LBA 0x2d08).
#
# 2. A bare PE image at the start of logfs (8 MiB, LUN4 LBA 0x9f391).
#    `fastboot flash logfs UniXNU.efi` from either ABL or U-Boot's own fastboot.
#    bootefi needs the size spelled out: a bare `bootefi <addr>` only accepts
#    addresses the EFI loader recorded itself.
#
# 3. U-Boot's fastboot gadget. This is the recovery channel: if nothing boots,
#    the handset enumerates on the PC as a fastboot device and the whole set of
#    U-Boot fastboot commands (flash/copy/oem) becomes available, so no reflash
#    of boot.img is needed to change the payload again.
bootcmd=echo === step1: efi boot manager;bootefi bootmgr;echo === step2: raw payload on logfs;scsi dev 4;scsi read 0xa0000000 0x9f391 400;bootefi 0xa0000000:400000;echo === step3: u-boot fastboot gadget;fastboot usb 0;echo === all attempts failed
menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=UEFI boot manager=bootefi bootmgr
bootmenu_1=U-Boot fastboot gadget=fastboot usb 0
bootmenu_2=U-Boot prompt=echo at the prompt
