# Kernel configuration of the rmx1901 image.
# Byte-identical to rmx1971_defconfig except for archive paths.

CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_BOOT_PROGRESS=y
CONFIG_XNU_DT_PANIC_REGION=y
CONFIG_XNU_CRYPTO_BOOTSTRAP="prelinked"
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/rmx1901-probes/libRmx1901Probes.a -Wl,-force_load,{tree}/build/rmx1901-windows/libRmx1901Windows.a"
CONFIG_XNU_RMX1901_ROOT_WINDOWS=y
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_AES=n
CONFIG_XNU_NATIVE_VIRTIO_BLOCK=n
CONFIG_XNU_NATIVE_RAM_BLOCK=n
CONFIG_XNU_NATIVE_MOBILE_DISPLAY=n
CONFIG_XNU_NATIVE_LEGACY_DISPLAY=n
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_NATIVE_PAN=n
CONFIG_XNU_SOURCE_MOCKFS=n
CONFIG_XNU_TRUST_CACHE_RUNTIME=y
# sirius (same SoC, same 21H461 IPSW, known to reach execve activate 0) builds
# this off. Leave it off until a build with it on is proven to add something.
CONFIG_XNU_NATIVE_CS_HASH_CACHE=n
CONFIG_XNU_SHENG_PMGR=1
