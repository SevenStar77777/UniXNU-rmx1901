# Root device on the internal UFS. Applied to every build of this board:
# without it XNU reaches bsd_init and then idles forever waiting for a root device.
sweet-ufs-root.patch
# Board-started SHNGROOT window publisher. Must come after sweet-ufs-root.patch
# so the exported UFS read/geometry primitives are present.
zzz-rmx1901-window-personality.patch
# Fine-grained boot_progress_stage probes around bsd_init()'s VFS_ROOT path.
zzza-rmx1901-vfsroot-probes.patch
# Trust-cache runtime bring-up, ported from 57UU/UniXNU-sirius (same SDM710).
# The ARM64/BCM2837 profile compiles trust_cache_runtime_init() out unless
# XNU_NATIVE_TRUST_CACHE is passed; without the call the bundle in the payload
# is never loaded and /sbin/launchd exec fails with errno 8 (ENOEXEC).
rmx1901-trust-cache-guard.patch
rmx1901-trust-cache-init.patch
# Synchronous execve trace. The boot panel's console region is an early
# snapshot (sirius HANDOFF) and freezes when the timer IRQ stops, so printf
# alone never reaches the photo. rmx1901-exec-panel.patch mirrors each exec
# step into boot_progress_stage(), which paints row 5 synchronously, so the
# exact step where pid1 stops is visible on the next boot photo.
# NOTE: XNU_BOOT_PROGRESS=1 makes boot_progress_stage a real function; the file
# explicitly #undef's any empty-macro definition from the stripped export header.
rmx1901-exec-panel.patch
# AMFI exec-policy bypass, ported from 57UU/UniXNU-sirius (same SDM710). The
# unmodified AMFI refuses every image (no trust cache it accepts) and kills
# launchd with EXEC_EXIT_REASON_SECURITY_POLICY; amfi boot args are ignored.
# With rmx1901-skip-cs=1 this records the answer and lets the image run, which
# is exactly how sirius reached "execve activate 0" and userland.
rmx1901-skip-exec-policy.patch
# Post-exec userland fix, ported from 57UU/UniXNU-sirius (same SDM710). After
# pid 1's exec writes argv into the init map, vm_fault installs the PTE but the
# retried copyout faults again because a stale translation fault is cached in
# the TLB and the invalidation never reaches that address. copyio has no restart
# path, so flush the fault page before returning from the recoverable abort.
# Touches only osfmk/arm64/sleh.c (no overlap with the other board patches).
rmx1901-post-exec-tlb-flush.patch
# Diagnostic: after exec_activate_image() reads /sbin/launchd, paint the first
# four header bytes plus resid onto the on-screen stage panel. One build tells
# us whether errno 8 (ENOEXEC) is an all-zero/short read, a valid Mach-O magic
# that a later gate rejects, or an encrypted/corrupt image. No behavior change.
rmx1901-launchd-magic-probe.patch
# The first magic probe showed magic=00000000 resid=0: the read finished with a
# full page but the bytes were zero. Pin down whether the zero comes from the
# vnode's data (second read also zero) or from the first buffer / TLB (second
# read valid), and print the resolved path and file size so a wrong vnode is
# excluded. One more build, then no more guessing at this layer.
rmx1901-launchd-read-probe.patch
# Which layer turns /sbin/launchd into zeros. Registers nothing; it only
# reports the vnode's BSD flags + decmpfs xattr size, and whether the read
# or page-in path bailed with ENOTSUP because the on-disk type (4/9) has no
# decompressor. One build names the layer; no behaviour change.
rmx1901-decmpfs-state-probe.patch
