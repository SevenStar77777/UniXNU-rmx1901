diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index c23e7fd..b6fd09a 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -918,16 +918,19 @@ bsd_init(void)
 	mountlist.tqh_first->mnt_flag |= MNT_ROOTFS;
 
 	bsd_init_kprintf("calling VFS_ROOT\n");
+	boot_progress_stage("rmx probe: pre VFS_ROOT");
 	/* Get the vnode for '/'.  Set fdp->fd_fd.fd_cdir to reference it. */
 	if (VFS_ROOT(mountlist.tqh_first, &init_rootvnode, vfs_context_kernel())) {
 		panic("bsd_init: cannot find root vnode: %s", PE_boot_args());
 	}
+	boot_progress_stage("rmx probe: post VFS_ROOT");
 	(void)vnode_ref(init_rootvnode);
 	(void)vnode_put(init_rootvnode);
 
 	lck_rw_lock_exclusive(&rootvnode_rw_lock);
 	set_rootvnode(init_rootvnode);
 	lck_rw_unlock_exclusive(&rootvnode_rw_lock);
+	boot_progress_stage("rmx probe: post set_rootvnode");
 	init_rootvnode = NULLVP;  /* use rootvnode after this point */
 
 
@@ -944,6 +947,16 @@ bsd_init(void)
 		require_rootauth = TRUE;
 #endif // XNU_TARGET_OS_OSX && defined(__arm64__)
 
+		/* RMX1901: skip Apple sealed-root auth on non-SEP hardware */
+		{
+			int rmx_allow_unverified = 0;
+			PE_parse_boot_argn("rmx1901-allow-unverified", &rmx_allow_unverified, sizeof(rmx_allow_unverified));
+			if (rmx_allow_unverified) {
+				require_rootauth = FALSE;
+			}
+		}
+		boot_progress_stage("rmx probe: pre ROOTAUTH");
+
 		if (require_rootauth) {
 			/* enforce sealedness */
 			int autherr = VNOP_IOCTL(rootvnode, FSIOC_KERNEL_ROOTAUTH, NULL, 0, vfs_context_kernel());
@@ -951,6 +964,7 @@ bsd_init(void)
 				panic("rootvp not authenticated after mounting");
 			}
 		}
+		boot_progress_stage("rmx probe: post ROOTAUTH");
 	}
 
 
