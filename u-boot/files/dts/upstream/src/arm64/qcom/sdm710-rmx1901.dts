        ramoops = [2f 72 65 73 65 72 76 65 64 2d 6d 65 6d 6f 72 79 2f 72 61 6d 6f 6f 70 73 40 30 78 30 78 42 37 45 30 30 30 30 30 00];
        kboot_uboot_logmem = [2f 72 65 73 65 72 76 65 64 2d 6d 65 6d 6f 72 79 2f 6b 62 6f 6f 74 5f 75 62 6f 6f 74 5f 6c 6f 67 6d 65 6d 40 30 78 42 38 32 30 30 30 30 30 00];
        apc0_pwrcl_vreg = [2f 72 65 67 75 6c 61 74 6f 72 2d 70 77 72 63 6c 00];
        apc0_l3_vreg = [2f 72 65 67 75 6c 61 74 6f 72 2d 6c 33 00];
        apc1_perfcl_vreg = [2f 72 65 67 75 6c 61 74 6f 72 2d 70 65 72 66 63 6c 00];
    };

    /* ABL leaves the framebuffer at 0x9c000000 (cont_splash_region in live FDT);
     * U-Boot's simple-framebuffer needs an explicit reg to show panic text. */
    framebuffer {
        compatible = "simple-framebuffer";
        reg = <0x0 0x9c000000 0x0 0x3d09000>;
    };
};
